FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY services/collector/go.mod services/collector/go.sum ./
RUN go mod download
COPY services/collector/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /collector ./cmd/collector

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /collector /usr/local/bin/collector
EXPOSE 8080
CMD ["collector"]
