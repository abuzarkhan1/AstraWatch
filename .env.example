# AstraWatch — Required environment variables (copy to .env and fill in)
# ----------------------------------------------------------------------
# NOTE (post-hardening): the orchestrator and collector REFUSE to start without
# JWT_SECRET, and realtime/analyzer fail closed (reject all tokens) when it is
# blank. Export the SAME value to every service or cross-service auth breaks.

# ── Authentication (shared across orchestrator, collector, realtime, analyzer) ──
# Must be at least 32 bytes (Keys.hmacShaKeyFor throws WeakKeyException otherwise).
# Use the same secret everywhere: `openssl rand -base64 48`
JWT_SECRET=

# ── Orchestrator (Spring Boot) ───────────────────────────────────────────────
# SMTP credentials for anomaly/healing emails. Leave blank to use MailHog.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
ASTRAWATCH_ALERT_RECIPIENT=admin@astrawatch.io
# OAuth client secrets — leave blank to disable provider login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signed unsubscribe tokens; if unset the orchestrator generates an ephemeral
# per-boot secret (issued links stop working after a restart).
ASTRAWATCH_MAIL_UNSUBSCRIBE_SECRET=

# ── Collector (Go) ───────────────────────────────────────────────────────────
# Internal token the operator uses to query the collector's metrics endpoint.
INTERNAL_API_TOKEN=
PORT=8080
KAFKA_BROKERS=localhost:9092
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=astrawatch
CLICKHOUSE_USER=astrawatch
CLICKHOUSE_PASSWORD=astrawatch
REDIS_ADDR=localhost:6379
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Payment service (Go) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Realtime (Node) ──────────────────────────────────────────────────────────
PORT=8084
REDIS_URL=redis://localhost:6379/0

# ── Analyzer (Python) ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CLICKHOUSE_HOST=localhost
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Operator (Go, in-cluster) ────────────────────────────────────────────────
COLLECTOR_URL=http://collector:8080
INTERNAL_API_TOKEN=
